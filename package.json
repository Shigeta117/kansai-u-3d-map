{
  "name": "kansai-u-3d-map",
  "version": "0.2.0",
  "private": true,
  "description": "Kansai University Senriyama Campus 3D diorama monorepo (core assets, lite viewer, and full guide app)",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm -w apps/guide run dev",
    "dev:guide": "npm -w apps/guide run dev",
    "dev:lite": "npm -w apps/lite run dev",
    "preview:guide": "npm -w apps/guide run preview",
    "preview:lite": "npm -w apps/lite run preview",
    "build": "npm -w apps/guide run build && npm -w apps/lite run build",
    "typecheck": "tsc -p packages/core/tsconfig.json --noEmit && tsc -p apps/guide/tsconfig.json --noEmit && tsc -p apps/lite/tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "data:fetch": "node scripts/fetch-open-data.mjs",
    "data:build": "node scripts/build-campus-data.mjs",
    "data:refresh": "npm run data:fetch && npm run data:build",
    "export:3d": "node scripts/export-3d-assets.mjs"
  },
  "dependencies": {
    "lucide-react": "^0.511.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "three": "^0.175.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.26.0",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/vite": "^4.1.6",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.1.4",
    "@types/react-dom": "^19.1.4",
    "@types/three": "^0.175.0",
    "@vitejs/plugin-react": "^4.4.1",
    "eslint": "^9.26.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.0.0",
    "pngjs": "^7.0.0",
    "tailwindcss": "^4.1.6",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.32.1",
    "vitest": "^3.1.3"
  }
}
